# EOOS Email 部署环境变量示例
# 用法：cp deploy/.env.example deploy/.env，然后修改 deploy/.env。
# 注意：.env 里不要写引号；真实密码、Secret Key 不要提交到 Git。

# =========================
# Docker 镜像
# =========================
# 单容器部署镜像。默认使用你的 GHCR 镜像。
# 本地源码构建请用：docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build
EOOS_IMAGE=ghcr.io/eoos996/eoos-email:latest

# 多容器调试版镜像。只在 docker-compose.stack.yml 中使用。
EOOS_API_IMAGE=ghcr.io/eoos996/eoos-email-api:latest
EOOS_WEB_IMAGE=ghcr.io/eoos996/eoos-email-web:latest
EOOS_POSTFIX_IMAGE=ghcr.io/eoos996/eoos-email-postfix:latest
EOOS_DOVECOT_IMAGE=ghcr.io/eoos996/eoos-email-dovecot:latest
EOOS_RSPAMD_IMAGE=ghcr.io/eoos996/eoos-email-rspamd:latest

# =========================
# 对外访问地址
# =========================
# 邮件服务器主机名，一般填你的邮件域名，例如 mail.example.com。
# 会影响 Postfix myhostname、DNS 展示、邮件链接等。
EOOS_PUBLIC_HOSTNAME=mail.example.com

# Webmail 对外访问地址。生产环境建议使用 https。
EOOS_PUBLIC_BASE_URL=https://mail.example.com

# 邮件客户端 TLS 证书。用于 SMTP 465/587、IMAP 993、POP3 995。
# 生产环境请挂载真实证书，并确保域名包含 EOOS_PUBLIC_HOSTNAME。
# 留空时 Dovecot/Postfix 会使用容器自带 localhost 自签证书；EOOS API 的 SMTP submission 不会启用。
EOOS_TLS_CERT_FILE=
EOOS_TLS_KEY_FILE=

# =========================
# 初始管理员
# =========================
# 第一次启动时会创建这个管理员账号。
EOOS_ADMIN_EMAIL=admin@example.com

# 生产环境必须改掉默认密码。
EOOS_ADMIN_PASSWORD=ChangeMe123!

# =========================
# API / 数据存储
# =========================
# API 监听地址。单容器里由 Nginx 反代到 127.0.0.1:8080。
EOOS_ADDR=:8080

# 容器内数据目录。docker-compose.yml 已把 eoos-data 挂到 /data。
EOOS_DATA_DIR=/data

# SQLite 数据库路径。
EOOS_DB_PATH=/data/eoos.db

# API database backend: sqlite (default), mysql, or postgres.
# For mysql/postgres, configure EOOS_DATABASE_URL and start with a new empty database.
# Existing SQLite data is never copied automatically.
EOOS_DB_DRIVER=sqlite
EOOS_DATABASE_URL=
EOOS_DB_MAX_OPEN_CONNS=20
EOOS_DB_MAX_IDLE_CONNS=10
EOOS_DB_CONN_MAX_LIFETIME_SECONDS=1800
EOOS_DB_CONN_MAX_IDLE_TIME_SECONDS=300
EOOS_DB_CONNECT_TIMEOUT_SECONDS=10

# Optional all-in-one MySQL variant (docker-compose.mysql.yml).
EOOS_MYSQL_DATABASE=eoos
EOOS_MYSQL_USER=eoos
EOOS_MYSQL_PASSWORD=
EOOS_MYSQL_ROOT_PASSWORD=

# Optional all-in-one PostgreSQL variant (docker-compose.postgres.yml).
# EOOS_POSTGRES_PASSWORD must use only letters, digits, dot, underscore, tilde, and hyphen.
EOOS_POSTGRES_DATABASE=eoos
EOOS_POSTGRES_USER=eoos
EOOS_POSTGRES_PASSWORD=
EOOS_POSTGRES_ADMIN_PASSWORD=

# Session Cookie 名称，一般不用改。
EOOS_COOKIE_NAME=eoos_session

# 登录会话有效期，单位：小时。默认 168 小时，即 7 天。
EOOS_SESSION_TTL_HOURS=168

# 是否允许非 HTTPS 下的 Cookie。生产环境建议 false；本地 HTTP 调试可改 true。
EOOS_ALLOW_INSECURE_HTTP=false

# =========================
# 注册与安全
# =========================
# 是否开放用户自行注册。
EOOS_OPEN_REGISTRATION=false

# 是否启用 2FA 功能总开关。
EOOS_TWO_FACTOR_ENABLED=false

# 是否启用 Cloudflare Turnstile 人机验证。
EOOS_TURNSTILE_ENABLED=false

# Turnstile Site Key，前端公开使用。未启用时可以留空。
EOOS_TURNSTILE_SITE_KEY=

# Turnstile Secret Key，服务端校验使用。未启用时可以留空。
EOOS_TURNSTILE_SECRET_KEY=

# =========================
# SMTP 发信
# =========================
# 单容器部署默认提交给容器内 Postfix。
# Split stack 会由 docker-compose.stack.yml 默认覆盖为 postfix:25。
# 如需在 split stack 使用外部 SMTP，可设置 EOOS_STACK_SMTP_HOST / EOOS_STACK_SMTP_PORT。
# 如果要走外部 SMTP，把 Host/Port/Username/Password 改成外部服务配置。
EOOS_SMTP_HOST=127.0.0.1
EOOS_SMTP_PORT=25
EOOS_STACK_SMTP_HOST=
EOOS_STACK_SMTP_PORT=
EOOS_SMTP_USERNAME=
EOOS_SMTP_PASSWORD=

# 外部 SMTP 要求 STARTTLS / TLS 时改 true；本机 Postfix 默认 false。
EOOS_SMTP_REQUIRE_TLS=false

# 开放 API 最终投递事件回调的 HMAC-SHA256 密钥。生产环境请使用高强度随机值。
# 未配置时 /api/open/v1/delivery-events 返回 503。
EOOS_DELIVERY_WEBHOOK_SECRET=

# 可选：把发送队列与最终投递状态主动推送给外部系统。URL 默认必须为公网 HTTPS。
EOOS_STATUS_WEBHOOK_URL=
EOOS_STATUS_WEBHOOK_SECRET=
# 仅可信内网或本地测试可开启；开启后也允许 HTTP 与私网目标。
EOOS_STATUS_WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# 第三方客户端 SMTP 提交，由 EOOS API 监听 587/465；启用前必须配置可读 TLS 证书。
EOOS_SUBMISSION_ADDR=
EOOS_SUBMISSION_TLS_ADDR=
EOOS_SUBMISSION_MAX_MESSAGE_MB=35

# =========================
# 收件 / Maildir 同步
# =========================
# Dovecot Maildir 根目录。docker-compose.yml 已把 maildata 挂到这里。
EOOS_MAILDIR_ROOT=/var/mail/vhosts

# 扫描 Maildir 的间隔，单位：秒。
EOOS_MAILDIR_SCAN_SECONDS=30

# Rspamd 从 SQLite 导出 DKIM 私钥到签名目录的间隔，单位：秒。
EOOS_RSPAMD_DKIM_SYNC_SECONDS=60

# 无人收件开关。false：未注册邮箱默认拒收；true：未注册收件地址进入全部邮件。
EOOS_CATCH_ALL_ENABLED=false

# 用户是否可以在个人中心自助申请邮箱。
EOOS_USER_MAILBOX_APPLY_ENABLED=false

# 允许自助申请的域名 ID，多个用英文逗号分隔。建议在后台“系统设置 > 邮件”里配置。
EOOS_USER_MAILBOX_DOMAIN_IDS=

# 禁止自助申请的邮箱前缀，多个用英文逗号分隔。
EOOS_RESERVED_MAILBOX_PREFIXES=admin,postmaster,abuse,hostmaster,webmaster,root,security,noreply,no-reply,mailer-daemon

# Webmail 是否自动轮询刷新邮件。
EOOS_MAIL_AUTO_REFRESH=true

# 自动刷新间隔，单位：秒。
EOOS_MAIL_REFRESH_SECONDS=30

# 是否启用外部 IMAP 接入。也可在后台“系统设置 > 外部 IMAP”里开启，默认关闭。
EOOS_EXTERNAL_IMAP_ENABLED=false

# 外部 IMAP 密码加密密钥。启用外部 IMAP 接入前必须设置为足够长的随机字符串；也可在后台“系统设置 > 外部 IMAP”里配置。
EOOS_EXTERNAL_IMAP_SECRET_KEY=

# 外部 IMAP 本地存储模式的后台同步间隔，单位：秒；也可在后台配置。
EOOS_EXTERNAL_IMAP_SYNC_SECONDS=300

# 是否允许用户配置 localhost / 内网 / link-local IMAP 主机。默认 false，避免 SSRF 风险；也可在后台配置。
EOOS_EXTERNAL_IMAP_ALLOW_PRIVATE_HOSTS=false

# Gmail 外部 IMAP OAuth2。也可在后台配置。回调地址：${EOOS_PUBLIC_BASE_URL}/api/external-imap-oauth/gmail/callback
EOOS_EXTERNAL_IMAP_GMAIL_CLIENT_ID=
EOOS_EXTERNAL_IMAP_GMAIL_CLIENT_SECRET=

# Microsoft 365 / Outlook 外部 IMAP OAuth2。也可在后台配置。回调地址：${EOOS_PUBLIC_BASE_URL}/api/external-imap-oauth/outlook/callback
EOOS_EXTERNAL_IMAP_OUTLOOK_CLIENT_ID=
EOOS_EXTERNAL_IMAP_OUTLOOK_CLIENT_SECRET=

# =========================
# Telegram Bot
# =========================
# 从 @BotFather 获取的 Bot Token。留空则不启动 Telegram Bot，不影响邮件服务。
EOOS_TELEGRAM_BOT_TOKEN=

# 长轮询超时，单位：秒。
EOOS_TELEGRAM_BOT_TIMEOUT_SECONDS=60

# 告警接收聊天 ID，多个用英文逗号分隔。需要该聊天已绑定 Bot 且用户是管理员。
EOOS_TELEGRAM_ADMIN_CHAT_IDS=

# 全局新邮件通知总开关。各用户可在 Web 设置页按邮箱单独开关。
EOOS_TELEGRAM_NOTIFY_ENABLED=true

# 发送队列积压告警阈值。
EOOS_TELEGRAM_ALERT_QUEUE_THRESHOLD=200

# =========================
# 系统
# =========================
# 容器时区。
TZ=Asia/Shanghai

